# ==============================================================================
# VAPOR OS ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env locally. Never commit actual secret values.
# ==============================================================================

# Application Environment
NODE_ENV=development
ENVIRONMENT=development
LOG_LEVEL=info

# Web Client Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# FastAPI Core Kernel Configuration
PORT=8000
HOST=0.0.0.0
SECRET_KEY=dev_vapor_secret_key_minimum_32_characters_long_for_hs256!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Database & Cache Configuration (PostgreSQL 16 & Redis 7)
DATABASE_URL=postgresql+asyncpg://vapor_user:vapor_password@localhost:5432/vapor_os
REDIS_URL=redis://localhost:6379/0

# PostgreSQL Credentials (for Docker Compose)
POSTGRES_USER=vapor_user
POSTGRES_PASSWORD=vapor_password
POSTGRES_DB=vapor_os
POSTGRES_PORT=5432

# AI Provider API Keys (Abstracted - Configured when ready)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
