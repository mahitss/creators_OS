# ============================================================================
# VAPOR OS — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ============================================================================
# Copy this file to .env and supply production secrets before deployment.
# NEVER commit raw passwords, private keys, or API tokens to source control.
# ============================================================================

# Application Environment & Logging
ENVIRONMENT=production                       # Environment name: production | staging | development (Required)
PROJECT_NAME="Vapor OS Core Kernel API"       # Application display name (Optional)
VERSION=1.0.0                                 # Application release version (Required)
LOG_LEVEL=INFO                                # Logging verbosity: DEBUG | INFO | WARNING | ERROR (Required)

# API Server Routing & Security
API_V1_STR=/api/v1                           # API route prefix (Required)
SECRET_KEY=CHANGE_THIS_TO_A_32BYTE_RANDOM_SECRET_KEY_IN_PRODUCTION # JWT signing secret (Required)
ALGORITHM=HS256                               # JWT algorithm (Required)
ACCESS_TOKEN_EXPIRE_MINUTES=1440             # Access token expiration in minutes (Required)

# Google Authentication (OAuth 2.0 / OpenID Connect)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com # Google OAuth Client ID (Required)
GOOGLE_CLIENT_SECRET=your-google-client-secret                    # Google OAuth Client Secret (Server-Side Only)
GOOGLE_REDIRECT_URI=http://localhost:3000/login                   # Google OAuth Authorized Redirect URI

# Database Connection Pool
DATABASE_URL=postgresql+asyncpg://vapor_user:SECURE_PASSWORD@postgres_host:5432/vapor_os # Primary async database URL (Required)
REDIS_URL=redis://redis_host:6379/0          # High-performance event cache & broker URL (Required)

# AI Gateway Configuration (OpenRouter is the Sole External AI Gateway)
OPENROUTER_API_KEY=                               # OpenRouter API secret key (Required for AI features)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1  # OpenRouter API Base URL (Required)
OPENROUTER_DEFAULT_MODEL=openrouter/free          # Default routing model (Optional)

# Data Loss Prevention (DLP) & Audit
DLP_ENFORCEMENT_ENABLED=true                  # Enable regex secret redaction & audit logging (Required)
AUDIT_LOG_IMMUTABLE=true                      # Require append-only audit event persistence (Required)
